# Copy to .env. scripts/run-local.sh loads it with uv --env-file.
PPB_DATABASE_URL=sqlite:///./ppb.db
# Build/export the matching PPB rules executable and resources first.
PPB_RULES_EXECUTABLE=.data/rules/PokePackBar
PPB_RULES_TIMEOUT=60
# Daily verified SQLite backups. Keep on a private disk; replicate externally for disk failure.
PPB_BACKUP_DIRECTORY=.data/backups
PPB_BACKUP_KEEP=14
# Optional shared private gateway credential, not a login system.
PPB_GATEWAY_KEY=
# Public tunnel deployments should admit only operator-issued invites/link codes.
PPB_REGISTRATION_MODE=open
# Enable only for a loopback Cloudflare connector; never trust arbitrary XFF.
PPB_TRUST_CLOUDFLARE_PROXY=0
# With a public tunnel, also block /ready, /docs, /redoc and /openapi.json at ingress.
PPB_PRIVATE_DIAGNOSTICS=0
